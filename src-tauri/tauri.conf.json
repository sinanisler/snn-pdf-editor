{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SNN PDF Editor",
  "version": "0.1.0",
  "identifier": "com.snn.pdfeditor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SNN PDF Editor",
        "width": 1320,
        "height": 880,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF Document", "description": "PDF Document", "role": "Editor" }
    ]
  }
}
